# Base URL of the n8n instance. Browser calls to /n8n/* are proxied to ${N8N_URL}/webhook/*
N8N_URL=http://localhost:5678

# Demo servers only: lists the demo accounts on the sign-in page (leave unset on public servers).
# NEXT_PUBLIC_DEMO_PASSWORD=Demo@2026

# Optional: version string for the service worker cache (defaults to the package version + build time).
# NEXT_PUBLIC_BUILD_ID=
