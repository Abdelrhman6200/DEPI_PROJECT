# ---- Copy to .env (scripts/setup.sh does this for you) ----

# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
# NOTE: on the free tier Google may use prompts to improve its products. Use synthetic data only.
GEMINI_API_KEY=
# Main model (Companion agent, verifiers, pre-visit brief, documents) and lite model (intake extraction, explanations).
# n8n reaches Gemini through the gateway (docker service "gemini", scripts/gemini-gateway.mjs): when a model is busy or
# over its free quota, the next one of its chain answers. Chains (best first; ';' between chains):
#   GEMINI_CHAINS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite;gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Gateway tuning (scripts/gemini-gateway.mjs). Empty GEMINI_CHAINS = the default chains shown above.
GEMINI_CHAINS=
# Time allowed until the response headers before the next model of the chain is tried (ms).
GEMINI_TIMEOUT_MS=20000
# When the model tried has not answered after this time, the next one starts too; the first answer wins (ms).
GEMINI_HEDGE_MS=8000
# Thinking level for the larger Gemini 3 models: low | medium | high | off.
GEMINI_THINKING=low
# Offline testing only (LLM_PROVIDER=ollama bash scripts/deploy-workflows.sh): the local tool-calling model that
# replaces the Gemini agent.
AGENT_OLLAMA_MODEL=qwen3.5:9b


# Local models served by Ollama on the host (GPU). Pulled by setup: ollama pull medgemma:4b && ollama pull nomic-embed-text
OLLAMA_URL=http://host.docker.internal:11434
MEDGEMMA_MODEL=medgemma:4b
# Optional: MedGemma on another machine (e.g. a GPU PC over Tailscale). Defaults to OLLAMA_URL.
MEDGEMMA_URL=
EMBED_MODEL=nomic-embed-text

# Accredited guideline sources (WF-024) use the free NCBI E-utilities. Both are optional: an email identifies the
# client to NCBI, and a free API key (https://account.ncbi.nlm.nih.gov/settings/) raises the limit from 3 to 10 requests/s.
NCBI_EMAIL=
NCBI_API_KEY=

# Data store: a Google spreadsheet (free). Leave GOOGLE_SA_EMAIL empty to use the local stand-in instead
# (docker service "sheets", nothing leaves this computer). Setup: docs/setup/google-sheets.md
#   SHEETS_ID                  the id in the spreadsheet address: https://docs.google.com/spreadsheets/d/<SHEETS_ID>/edit
#   GOOGLE_SA_EMAIL            the service account (share the spreadsheet and the knowledge folder with it)
#   GOOGLE_SA_KEY              its private key from the JSON key file, in double quotes, on one line with \n for the
#                              line breaks: GOOGLE_SA_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#   DRIVE_KNOWLEDGE_FOLDER_ID  the Google Drive folder of knowledge documents (https://drive.google.com/drive/folders/<id>)
SHEETS_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
DRIVE_KNOWLEDGE_FOLDER_ID=
# Sheets cache (scripts/sheets-cache.mjs): a tab edited by hand in Google Sheets is seen after this time at the latest (ms).
SHEETS_CACHE_TTL_MS=600000
# Local stand-in only: 60 imitates Google's per-minute quota (to try a load before moving to Google); 0 = no limit.
EMULATOR_QUOTA_PER_MINUTE=0
DEMO_PASSWORD=Demo@2026

# n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
# Encrypts the health records and uploaded documents on disk (AES-256-GCM): 64 hex characters. scripts/setup.sh creates
# it. Keep a copy somewhere safe, off this computer: without it the data cannot be read.
DATA_ENCRYPTION_KEY=
N8N_OWNER_EMAIL=owner@demo.health
N8N_OWNER_PASSWORD=Owner@2026demo
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none

# Web app
N8N_URL=http://localhost:5678

# Optional email (password reset links, family invitation codes). Any SMTP account works, for example Gmail with an
# app password: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASSWORD=<app password>.
# Local development: bash scripts/setup.sh starts Mailpit; read the emails at http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM="MediCare <no-reply@localhost>"
# Address of the web app, used in links inside emails.
APP_URL=http://localhost:3000

# Deployment mode. This computer (scripts/setup.sh) loads the demo data. The production installer
# (infra/hostinger/install.sh, settings in infra/hostinger/.env) defaults to SEED_DEMO=false: no demo people or synthetic
# data, the demo CGM simulator off, the first platform administrator is PLATFORM_ADMIN_EMAIL / PLATFORM_ADMIN_PASSWORD
# (must change it at first sign-in), staff two-factor sign-in is required unless REQUIRE_STAFF_MFA=false, and
# BACKUP_AGE_RECIPIENT is required. A demo server needs SEED_DEMO=true (scripts/deploy-hostinger.sh ... --demo).
SEED_DEMO=true
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
REQUIRE_STAFF_MFA=
# n8n editor on the production :8443 port is reachable only from these addresses (space-separated, CIDR allowed).
N8N_ADMIN_IPS=127.0.0.1/32
# Production only (infra/hostinger/.env): the public hostname (Caddy gets its certificate for it) and the email
# Let's Encrypt sends certificate notices to. scripts/deploy-hostinger.sh writes both.
DOMAIN=
ACME_EMAIL=
# Backups (infra/hostinger/backup.sh, nightly on the server; restore.sh reads them back):
#   BACKUP_AGE_RECIPIENT  age public key (age1..., from age-keygen on YOUR computer): every backup is encrypted for it.
#                         Required on a real deployment (SEED_DEMO=false).
#   BACKUP_AGE_IDENTITY   restore only: the matching private key file (keep it off the server otherwise)
#   BACKUP_OFFSITE_CMD    optional: run with each finished file as its last argument, e.g. "rclone copy --no-traverse remote:dir"
#   BACKUP_DIR            default /var/backups/health-platform
#   BACKUP_KEEP           newest files kept of each kind, default 14
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
BACKUP_OFFSITE_CMD=
BACKUP_DIR=/var/backups/health-platform
BACKUP_KEEP=14
# Optional: show the demo accounts on the sign-in page (demo builds only; the password is then visible to visitors).
NEXT_PUBLIC_DEMO_PASSWORD=
# Debugging only: keep n8n execution data (it contains health information). Leave empty in normal use.
DEBUG_EXECUTIONS=

# Web push (free, no account): node scripts/set-vapid-keys.mjs fills these. The public key goes to browsers, the private
# key signs push requests in n8n. Without them notifications stay in the app only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Tracing (optional): self-hosted Langfuse on http://localhost:3010. node scripts/set-langfuse.mjs starts it and fills
# these. Traces carry metadata and judge scores only (no message text, no patient or user ids). Production server:
# docs/deploy/hostinger.md, "Tracing" (Langfuse is not part of the server stack).
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Sheets write safety (scripts/sheets-cache.mjs). Writes carry checks of what was read and the cache refuses a write
# whose rows changed meanwhile (the request is re-run). off = n8n talks to Google directly, without the cache.
SHEETS_WRITE_GUARDS=on
# always = re-read guarded tabs before every write (also catches edits made by hand in the spreadsheet; one extra read).
GUARD_RECHECK=
# The only header trusted for the client address (rate limits). Empty: cf-connecting-ip, x-real-ip, then x-forwarded-for.
# Production behind Caddy sets x-real-ip (infra/hostinger/docker-compose.yml).
CLIENT_IP_HEADER=
