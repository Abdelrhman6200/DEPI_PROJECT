{
  "type": "object",
  "properties": {
    "specialty": {
      "type": "string",
      "description": "One code from SPECIALTIES"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "urgent",
        "priority",
        "routine"
      ]
    },
    "cc": {
      "type": "string",
      "description": "Chief complaint in English, at most 12 words"
    },
    "cc_ar": {
      "type": "string",
      "description": "The same in Arabic"
    },
    "why": {
      "type": "string",
      "description": "Why this specialty, one English sentence for reception"
    },
    "why_ar": {
      "type": "string",
      "description": "The same in Arabic"
    },
    "red_flags": {
      "type": "array",
